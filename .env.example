# ==============================================================================
# ExamSeat AI - Environment Variables Template
# Copy this file to .env or configure your environment variables
# ==============================================================================

# Supabase PostgreSQL Connection
# Direct connection (port 5432) or Session/Transaction pooler (port 6543)
SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_database_password

# Supabase Auth / Project URL (Optional if using direct token verification)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Spring Boot Security JWT Secret (minimum 256-bit / 32 characters)
APP_JWT_SECRET=super_secret_jwt_signing_key_for_examseat_ai_must_be_long_and_secure_32chars

# Application Server Port
PORT=8080

# Institution Branding
COLLEGE_NAME=ExamSeat Institute of Technology & Management
COLLEGE_ADDRESS=University Campus, Innovation Road, Metro City - 600001
COLLEGE_CODE=ESITM-2026
